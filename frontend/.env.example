# Copy this file to ".env" (same folder) and edit it. Never commit the real .env file.

# false = talk to the real FastAPI backend (recommended)
# true  = run the frontend alone with fake data (no backend needed; nothing you do is saved)
VITE_USE_MOCK=false

# true  = pre-fill demo logins and show the demo OTP hint on the login page
# false = show empty fields (use this for the final demo to judges if you prefer)
VITE_DEMO_MODE=true

# Leave as /api when using the Vite proxy (recommended).
VITE_API_BASE_URL=/api

# Where the Vite dev/preview proxy forwards /api and /uploads.
# Use 127.0.0.1 (not "localhost") to avoid IPv6 connection errors on some Windows setups.
# If port 8000 is blocked on your PC (WinError 10013), start the backend on another port
# (for example 8001) and change it here too.
VITE_BACKEND_URL=http://127.0.0.1:8000
