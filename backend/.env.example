# Copy this file to .env and fill in real values.
# NEVER commit the real .env to Git.

# Groq assistant (optional - the app works with template answers if this is empty)
GROQ_API_KEY=your_groq_api_key_here
# Must be a model id that Groq currently serves AND that supports tool calling (check https://console.groq.com/docs/models).
GROQ_MODEL=openai/gpt-oss-120b

# REQUIRED for stable logins: a long random string (python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# true = fixed demo OTP 123456 and demo hints; false = random OTP (printed to the server log until an SMS provider is added)
DEMO_MODE=true

# Comma separated browser origins allowed to call the API directly (the Vite proxy does not need CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file, resolved relative to the backend/ folder
DB_URL=sqlite:///./ghostwatt.db
